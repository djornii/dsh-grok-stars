{
    "name": "@local/grok-stars",
    "version": "1.1.0",
    "private": true,
    "type": "module",
    "exports": {
        ".": "./index.js",
        "./client": "./client.js",
        "./locale/*.json": "./locale/*.json"
    },
    "files": [
        "index.js",
        "client.js",
        "cordis.patch.yml",
        "locale/*.json"
    ],
    "dsh": {
        "bundle": {
            "patch": "./cordis.patch.yml"
        },
        "client": {
            "platform": "web",
            "immediately": true,
            "inject": [
                "@deepseek-ai/dsh-client-ui-conversation",
                "@deepseek-ai/dsh-client-ui-theme"
            ]
        }
    }
}
